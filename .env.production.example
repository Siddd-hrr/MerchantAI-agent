# Production environment template — copy to `.env` on the VPS only.
# NEVER commit a real `.env` file. Fill secrets on the server (chmod 600).
#
# Inside Docker Compose, use service hostnames (postgres/redis/kafka), not localhost.

GOOGLE_API_KEY=
GEMINI_MODEL_NAME=gemma-4-31b-it
MERCHANT_NAME=Acme Mart

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=merchant_ai
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/merchant_ai
OFFER_DATABASE_URL=

REDIS_URL=redis://redis:6379/0
OFFER_REDIS_URL=

TRUSTED_MANDATE_ISSUERS=
ALLOW_GLOBAL_TRUSTED_ISSUERS_FALLBACK=false
MANDATE_MAX_AGE_SECONDS=300

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
WORKER_URL=http://nginx-workers
AGENT_URL=http://nginx-agents
ADMIN_HOST=0.0.0.0
ADMIN_PORT=8003
OFFER_ENGINE_URL=http://offer_engine:8004
RESERVATION_SERVICE_URL=http://reservation_service:8005
AUTH_SERVICE_URL=http://auth_service:8006
PAYMENT_SERVICE_URL=http://payment_service:8007
PAYMENT_LOG_SERVICE_URL=http://payment_log_service:8008
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DEFAULT_MERCHANT_ID=

JWT_SECRET=
JWT_EXPIRY_MINUTES=1440
CREDENTIAL_ENCRYPTION_KEY=

RESERVATION_TTL_SECONDS=480
# Set to live only when Razorpay production keys/webhook are configured.
RAZORPAY_MODE=fake
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_LINK_TTL_SECONDS=300
RESERVATION_SCAN_INTERVAL_SECONDS=30
REACT_LOOP_MAX=4

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=merchant-ai-production

RATE_LIMIT_PER_MINUTE=60
CATALOG_CACHE_TTL_SECONDS=600
SESSION_TTL_SECONDS=1800
LOG_LEVEL=INFO
ENVIRONMENT=production

# Public URLs baked into the frontend image at build time (no secrets).
# Replace with your HTTPS domain after TLS is configured.
VITE_AUTH_SERVICE_URL=https://api.example.com
VITE_ADMIN_SERVICE_URL=https://api.example.com
VITE_GATEWAY_URL=https://api.example.com
VITE_PAYMENT_LOG_SERVICE_URL=https://api.example.com
